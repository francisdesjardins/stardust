{
  "name": "@stardust/solid",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@stardust/core": "^0.1.0",
    "solid-js": ">=1.8.0"
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:esm",
    "build:clean": "rimraf dist",
    "build:esm": "tsc --noEmit && vite build --config vite.config.esm.ts",
    "type-check": "tsc --noEmit",
    "test": "playwright test -c playwright.config.ts",
    "test:ui": "playwright test -c playwright.config.ts --ui",
    "test:unit": "playwright test -c playwright.config.ts --project=unit",
    "test:unit:ui": "playwright test -c playwright.config.ts --project=unit --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@stardust/core": "*",
    "rimraf": "^6.1.3",
    "solid-js": "1.9.12",
    "vite": "^8.0.11",
    "vite-plugin-dts": "5.0.0",
    "vite-plugin-solid": "^2.11.12"
  }
}
