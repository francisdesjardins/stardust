{
  "name": "@stardust/react",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@stardust/core": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:esm",
    "build:clean": "rimraf dist",
    "build:esm": "tsc --noEmit && vite build --config vite.config.esm.ts",
    "type-check": "tsc --noEmit",
    "test": "playwright test -c playwright.config.ts",
    "test:ui": "playwright test -c playwright.config.ts --ui",
    "test:unit": "playwright test -c playwright.config.ts --project=unit",
    "test:unit:ui": "playwright test -c playwright.config.ts --project=unit --ui",
    "test:component": "playwright test -c playwright.config.ts --project=component",
    "test:component:ui": "playwright test -c playwright.config.ts --project=component --ui"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "1.59.1",
    "@playwright/test": "1.59.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@stardust/core": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "5.0.0"
  }
}
