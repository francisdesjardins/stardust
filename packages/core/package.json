{
  "name": "@stardust/core",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "browser": "./dist/umd/stardust-core.umd.js",
      "default": "./dist/esm/index.js"
    },
    "./async-state": {
      "types": "./dist/esm/async-state.d.ts",
      "import": "./dist/esm/async-state.js",
      "default": "./dist/esm/async-state.js"
    },
    "./path-utils": {
      "types": "./dist/esm/path-utils.d.ts",
      "import": "./dist/esm/path-utils.js",
      "default": "./dist/esm/path-utils.js"
    },
    "./watch": {
      "types": "./dist/esm/watch.d.ts",
      "import": "./dist/esm/watch.js",
      "default": "./dist/esm/watch.js"
    },
    "./produce": {
      "types": "./dist/esm/produce.d.ts",
      "import": "./dist/esm/produce.js",
      "default": "./dist/esm/produce.js"
    },
    "./shallow-equal": {
      "types": "./dist/esm/shallow-equal.d.ts",
      "import": "./dist/esm/shallow-equal.js",
      "default": "./dist/esm/shallow-equal.js"
    },
    "./umd": "./dist/umd/stardust-core.umd.js"
  },
  "typesVersions": {
    "*": {
      "async-state": [
        "./dist/esm/async-state.d.ts"
      ],
      "path-utils": [
        "./dist/esm/path-utils.d.ts"
      ],
      "watch": [
        "./dist/esm/watch.d.ts"
      ],
      "produce": [
        "./dist/esm/produce.d.ts"
      ],
      "shallow-equal": [
        "./dist/esm/shallow-equal.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:esm && npm run build:umd",
    "build:clean": "rimraf dist",
    "build:esm": "tsc --noEmit && vite build --config vite.config.esm.ts",
    "build:umd": "vite build --config vite.config.umd.ts",
    "type-check": "tsc --noEmit",
    "test": "playwright test -c playwright.config.ts",
    "test:ui": "playwright test -c playwright.config.ts --ui",
    "test:unit": "playwright test -c playwright.config.ts --project=unit",
    "test:unit:coverage": "c8 playwright test -c playwright.config.ts --project=unit",
    "test:unit:ui": "playwright test -c playwright.config.ts --project=unit --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "c8": "11.0.0",
    "fast-check": "4.7.0",
    "rimraf": "^6.1.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "5.0.0-beta.6"
  }
}
